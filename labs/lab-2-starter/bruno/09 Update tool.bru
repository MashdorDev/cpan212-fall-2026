meta {
  name: Update tool
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/tools/{{toolId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "Hedge trimmer",
    "category": "garden",
    "condition": "worn",
    "available": false,
    "maxLoanDays": 5
  }
}

assert {
  res.status: eq 200
}

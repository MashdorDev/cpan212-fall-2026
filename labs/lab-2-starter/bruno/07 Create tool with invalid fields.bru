meta {
  name: Create tool with invalid fields
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/tools
  body: json
  auth: none
}

body:json {
  {
    "name": "X",
    "category": "boats",
    "condition": "good",
    "available": "yes",
    "maxLoanDays": 30
  }
}

assert {
  res.status: eq 400
}

PORT=4000
# Local MongoDB, or your Atlas connection string. The part after the last / is the database name.
MONGODB_URI=mongodb://127.0.0.1:27017/campus_events
# Signs the session cookie. Required: the API won't start without it. Run npm run generate-secret for a value.
SESSION_SECRET=replace-me-with-the-output-of-npm-run-generate-secret
# Set to production when deployed (render.yaml does), so the session cookie is only sent over HTTPS.
NODE_ENV=development
# Origins allowed to call the API directly from a browser (CORS), separated by commas.
# The Next.js app doesn't need to be listed: it goes through its /api rewrite.
CORS_ORIGINS=
# Number of proxies in front of the API. Leave empty on your computer. Render needs 1 (render.yaml sets it).
TRUST_PROXY=
HOLIDAY_API_BASE_URL=https://date.nager.at/api/v3

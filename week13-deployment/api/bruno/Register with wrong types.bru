meta {
  name: Register with wrong types
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Wrong Types",
    "email": {
      "$ne": null
    },
    "password": [
      "not",
      "text"
    ]
  }
}

assert {
  res.status: eq 400
}

docs {
  Objects and arrays where text belongs get a 400 before they reach the database.
}

<%- include('partials/header', { title }) %>

<div class="page-heading">
  <h1>Events</h1>
  <a class="button" href="/admin/events/new">Add an event</a>
</div>

<% if (events.length === 0) { %>
  <p>No events yet.</p>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Image</th>
          <th>Title</th>
          <th>Category</th>
          <th>Starts (Toronto time)</th>
          <th>Location</th>
          <th>Capacity</th>
          <th><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% for (const event of events) { %>
          <tr>
            <td>
              <% if (event.imageUrl) { %>
                <img class="thumb" src="<%= event.imageUrl %>" alt="" width="64" height="64" />
              <% } %>
            </td>
            <td><%= event.title %></td>
            <td><%= event.category %></td>
            <td><time datetime="<%= event.startsAt %>"><%= formatEventDate(event.startsAt) %></time></td>
            <td><%= event.location %></td>
            <td><%= event.capacity %></td>
            <td>
              <form method="post" action="/admin/events/<%= event.id %>/delete" data-confirm="Delete &quot;<%= event.title %>&quot;?">
                <button class="danger" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/footer') %>

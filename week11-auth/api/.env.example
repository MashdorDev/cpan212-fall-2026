PORT=4000
# Local MongoDB, or your Atlas connection string. The part after the last / is the database name.
MONGODB_URI=mongodb://127.0.0.1:27017/campus_events
# Signs the session cookie. Required: the API won't start without it. Use a long random value, for example
# the output of: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-me-with-a-long-random-value
# Set to production when deployed, so the session cookie is only sent over HTTPS.
NODE_ENV=development
HOLIDAY_API_BASE_URL=https://date.nager.at/api/v3

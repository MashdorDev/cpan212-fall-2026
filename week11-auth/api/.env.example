PORT=4000
# Your Atlas connection string, or a MongoDB on your own computer.
# The part after the last / is the database name. Events, users and sessions all go here.
MONGODB_URI=mongodb://127.0.0.1:27017/campus_events
# Signs the session cookie. The API won't start without it. Make one with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-me-with-a-long-random-value
# Set to production when the API is deployed. The cookie is then only sent over HTTPS.
NODE_ENV=development
HOLIDAY_API_BASE_URL=https://date.nager.at/api/v3

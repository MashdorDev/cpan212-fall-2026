meta {
  name: Register
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Nora Quinn",
    "email": "nora.quinn@example.com",
    "password": "correct horse battery"
  }
}

assert {
  res.status: eq 201
}

docs {
  Creates an account and logs it in. Run npm run seed to remove it again, or the next run gets a 409.
}

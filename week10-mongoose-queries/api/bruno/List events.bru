meta {
  name: List events
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/events
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.page: eq 1
  res.body.limit: eq 10
}

vars:post-response {
  eventId: res.body.data[0].id
}

docs {
  Run this first. It saves the id of the first event as eventId for the requests that need one.
}

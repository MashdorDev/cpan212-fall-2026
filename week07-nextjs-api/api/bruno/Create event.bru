meta {
  name: Create event
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/events
  body: json
  auth: none
}

body:json {
  {
    "title": "Robotics club open house",
    "description": "See this year's competition robot and find out how to join the build team.",
    "category": "academic",
    "location": "North Campus, Room B204",
    "startsAt": "2026-10-08T18:00:00-04:00",
    "capacity": 45
  }
}

assert {
  res.status: eq 201
}

vars:post-response {
  createdEventId: res.body.data.id
}
